DATABASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
# The verified Brevo sender every message goes out as
MAIL_FROM=
MAIL_FROM_NAME=

PORT=
JWT_SECRET=
# Access token lifetime for whatever issues tokens (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in whole days (default 30)
REFRESH_EXPIRES_IN_DAYS=30

# Comma separated origins allowed to call the API, e.g. the Admin Web
# deployment. Leave unset to allow any origin during local development.
ALLOWED_ORIGINS=

# Seeded on boot as the one ADMIN account; the password is hashed before
# it is stored and is only read at seed time.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
